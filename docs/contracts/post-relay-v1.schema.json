{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuttlepub.invalid/contracts/emumet-post-relay/v1.schema.json",
  "title": "Emumet post-relay envelope v1",
  "description": "Body of POST /internal/v1/emumet/activities. One envelope = one Profile = one received Activity. Cross-field and byte-level rules that JSON Schema cannot express are listed in v1.md ('Checks outside the schema'). Constants agree with v1.constants.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receipt_id",
    "received_at",
    "sender",
    "recipient",
    "activity",
    "verification",
    "original_request",
    "evidence_complete",
    "omitted_header_names",
    "omitted_header_count"
  ],
  "properties": {
    "version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/opaque_id" },
    "received_at": { "$ref": "#/$defs/timestamp" },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "instance_actor"],
      "properties": {
        "origin": { "$ref": "#/$defs/origin" },
        "instance_actor": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[a-z0-9]+([.-][a-z0-9]+)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?/ap/instance$"
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "profile_actor", "link_id", "link_generation"],
      "properties": {
        "origin": { "$ref": "#/$defs/origin" },
        "profile_actor": { "$ref": "#/$defs/emumet_url" },
        "link_id": { "$ref": "#/$defs/opaque_id" },
        "link_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "body_encoding", "raw_body"],
      "properties": {
        "id": {
          "description": "Activity id extracted from the body, or null when it is missing or not extractable as a string. Never invented.",
          "oneOf": [{ "$ref": "#/$defs/remote_url" }, { "type": "null" }]
        },
        "actor": { "$ref": "#/$defs/remote_url" },
        "body_encoding": { "const": "base64" },
        "raw_body": {
          "description": "Standard Base64 (RFC 4648 section 4, with padding) of the exact bytes received on the inbox. The decoded size is at most 1048576 bytes (checked outside the schema).",
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "scheme", "key_id", "signer_actor", "verified_at"],
      "properties": {
        "result": { "const": "verified" },
        "scheme": { "enum": ["cavage", "rfc9421"] },
        "key_id": { "$ref": "#/$defs/remote_url" },
        "signer_actor": { "$ref": "#/$defs/remote_url" },
        "verified_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "original_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "request_target", "signature_headers"],
      "properties": {
        "method": { "const": "POST" },
        "request_target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/[\\x21-\\x7e]*$"
        },
        "signature_headers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "$ref": "#/$defs/header_name" },
              "value": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[\\x20-\\x7e]*$"
              }
            }
          }
        }
      }
    },
    "evidence_complete": { "type": "boolean" },
    "omitted_header_names": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/header_name" }
    },
    "omitted_header_count": { "type": "integer", "minimum": 0, "maximum": 1024 }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_complete": { "const": true } }, "required": ["evidence_complete"] },
      "then": {
        "properties": {
          "omitted_header_count": { "const": 0 },
          "omitted_header_names": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "evidence_complete": { "const": false } }, "required": ["evidence_complete"] },
      "then": { "properties": { "omitted_header_count": { "minimum": 1 } } }
    }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "description": "RFC 3339 in UTC with a literal Z; optional fractional seconds (1-9 digits). Month 01-12, day 01-31, hour 00-23, minute and second 00-59. That the day exists in that month and year is checked outside the schema (v1.md section 4.5).",
      "type": "string",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "origin": {
      "description": "Normalized origin: lowercase https scheme and host, no userinfo, path, query or fragment, no default port (:443); port 1-65535 without leading zeros.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^https://[a-z0-9]+([.-][a-z0-9]+)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$",
      "not": { "pattern": ":443$" }
    },
    "emumet_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[a-z0-9]+([.-][a-z0-9]+)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?/[\\x21-\\x7e]*$"
    },
    "remote_url": {
      "description": "http or https URL: scheme://host[:port] and then nothing, or one of / ? # followed by printable ASCII. No userinfo, no IPv6 literal, no empty authority (v1.md section 4.5).",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[A-Za-z0-9]+([.-][A-Za-z0-9]+)*(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?([/?#][\\x21-\\x7e]*)?$"
    },
    "header_name": {
      "description": "Lowercase header field name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
    }
  }
}
