DATABASE_URL=postgres://postgres:develop@localhost:5432/postgres
# or
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=develop
DATABASE_NAME=postgres

HYDRA_ISSUER_URL=http://localhost:4444/
HYDRA_ADMIN_URL=http://localhost:4445/
KRATOS_PUBLIC_URL=http://localhost:4433/
EXPECTED_AUDIENCE=account

KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467

REDIS_URL=redis://localhost:6379
# or
REDIS_HOST=localhost

WORKER_ID=0

CORS_ALLOWED_ORIGINS=*

# Required when running with test-mode feature:
# EMUMET_TEST_MODE_TOKEN=your-test-token

PUBLIC_BASE_URL=http://localhost:8080
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=emumet-media
S3_ACCESS_KEY=emumetdevelop
S3_SECRET_KEY=emumet-develop-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/emumet-media
#
# For AP E2E tests (with compose.ap-e2e.yml nginx proxy):
# PUBLIC_BASE_URL=https://emumet.127.0.0.1.nip.io
# PEER_BASE_URL=https://peer.127.0.0.1.nip.io:8443
#
# For AP E2E compose environment:
# Set these when running with compose.ap-e2e.yml
# The server API goes through direct HTTP to avoid nginx proxy issues,
# while the public URL is used for ActivityPub ID generation and signing.
# EMUMET_E2E_SERVER_BASE_URL=http://localhost:8080
# EMUMET_E2E_PUBLIC_BASE_URL=https://emumet.127.0.0.1.nip.io
# PUBLIC_BASE_URL=${EMUMET_E2E_PUBLIC_BASE_URL}
# EMUMET_E2E_EXTERNAL_SERVER=1
# AP_TEST_ALLOWED_FETCH_HOSTS=127.0.0.1,iceshrimp.127.0.0.1.nip.io  # Allowlisted hosts for test-mode AP fetches
# AP_TEST_ACCEPT_INVALID_CERTS=1          # Accept self-signed certs in test-mode (value must be "1", not "true")
# ICESHRIMP_BASE_URL=https://iceshrimp.127.0.0.1.nip.io:8443

# Registration gate notification Webhook (D15 / E15w / E15x). See docs/registration-gate-webhook.md.
# Destinations are managed by admins through the API (multiple, HTTPS only, per-destination HMAC-SHA256
# secret stored encrypted). Creating a destination or replacing its secret needs this key (base64, 32 bytes;
# generate with `openssl rand -base64 32`; keep it apart from DB backups; losing it means re-entering secrets):
# REGISTRATION_WEBHOOK_ENCRYPTION_KEY=
# REGISTRATION_WEBHOOK_ENCRYPTION_KEY_FILE=/run/secrets/registration-webhook-encryption-key   # instead of REGISTRATION_WEBHOOK_ENCRYPTION_KEY
# Legacy single destination (E15w). Leave unset to disable (not an error). With the encryption key configured it is
# imported once at startup as a regular destination (the variables are ignored afterwards); without the key it keeps
# delivering as a read-only destination.
# REGISTRATION_WEBHOOK_URL=https://hooks.example.com/emumet
# REGISTRATION_WEBHOOK_SECRET=change-me-to-a-random-value-of-32-bytes-or-more
# REGISTRATION_WEBHOOK_SECRET_FILE=/run/secrets/registration-webhook-secret   # instead of REGISTRATION_WEBHOOK_SECRET
# REGISTRATION_WEBHOOK_POLL_INTERVAL_MS=2000

# Registration protection readiness (E15c). See docs/registration-protection-readiness.md.
# Cloudflare Turnstile (bot protection). EXPECTED_HOSTNAME is required when enabled.
# REGISTRATION_TURNSTILE_SITE_KEY=0x4AAAAAAA-your-site-key
# REGISTRATION_TURNSTILE_SECRET=change-me
# REGISTRATION_TURNSTILE_SECRET_FILE=/run/secrets/turnstile-secret   # instead of REGISTRATION_TURNSTILE_SECRET
# REGISTRATION_TURNSTILE_EXPECTED_HOSTNAME=emumet.example.com
# REGISTRATION_TURNSTILE_EXPECTED_ACTION=register
# SMTP (email ownership proof). TLS is STARTTLS (587) by default; `tls` = implicit TLS (465).
# REGISTRATION_SMTP_HOST=smtp.example.com
# REGISTRATION_SMTP_PORT=587
# REGISTRATION_SMTP_TLS=starttls
# REGISTRATION_SMTP_USERNAME=mailer
# REGISTRATION_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# REGISTRATION_EMAIL_FROM=Emumet <no-reply@example.com>
# REGISTRATION_EMAIL_CANARY_ADDRESS=ops-canary@example.com   # approved mailbox for the admin canary roundtrip

# E15d preparation only: production Kratos is not wired to this listener yet.
# Keep disabled until the attestation/ingress integration is configured.
# REGISTRATION_ENFORCEMENT_ENABLED=false
# REGISTRATION_HOOK_LISTEN=127.0.0.1:8081
# REGISTRATION_HOOK_ALLOWED_PEERS=127.0.0.1,::1
# REGISTRATION_HOOK_SECRET_FILE=/run/secrets/registration-hook-secret
# REGISTRATION_PROTECTION_POLL_SECS=30
